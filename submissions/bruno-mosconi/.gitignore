# Um único .gitignore para toda a submissão. Sem "/" no início ou no meio dos padrões:
# tools/adicionar-ao-git.sh aplica estas regras a partir da raiz do repositório.

# Dependências e builds
node_modules/
dist/
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# Python
__pycache__/
.venv/

# Deploy e segredos
.vercel/
.env
.env.*
*.pem
*.key
# Configuração de MCP: pode conter chave de API (Krea)
.mcp.json
# Termos privados da limpeza dos exports (tools/limpar-exports.mjs)
.termos-privados

# Preferências locais do Claude Code (não versionar)
settings.local.json
CLAUDE.local.md
scheduled_tasks.lock

# Sistema
.DS_Store
