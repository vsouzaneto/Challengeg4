{"datasets": [{"name": "tile1_volume", "displayName": "Volume", "query": "\nSELECT platform, content_type, content_category, COUNT(*) AS posts\nFROM workspace.social.social_media_dataset\nGROUP BY platform, content_type, content_category\nORDER BY posts DESC\n"}, {"name": "tile2_controlled", "displayName": "Taxa controlada", "query": "\nSELECT\n  platform,\n  content_type,\n  content_category,\n  CASE\n    WHEN follower_count < 10000 THEN 'lt_10k'\n    WHEN follower_count < 50000 THEN '10k_50k'\n    WHEN follower_count < 200000 THEN '50k_200k'\n    ELSE '200k_plus'\n  END AS creator_band,\n  is_sponsored,\n  COUNT(*) AS posts,\n  ROUND(AVG((likes + shares + comments_count) / views), 4) AS eng_per_view,\n  ROUND(AVG(views), 0) AS avg_views,\n  ROUND(AVG(shares), 1) AS avg_shares\nFROM workspace.social.social_media_dataset\nGROUP BY platform, content_type, content_category,\n  CASE\n    WHEN follower_count < 10000 THEN 'lt_10k'\n    WHEN follower_count < 50000 THEN '10k_50k'\n    WHEN follower_count < 200000 THEN '50k_200k'\n    ELSE '200k_plus'\n  END,\n  is_sponsored\nHAVING COUNT(*) >= 30\nORDER BY eng_per_view DESC\n"}, {"name": "tile3_raw", "displayName": "Org vs ads cru", "query": "\nSELECT\n  is_sponsored,\n  COUNT(*) AS posts,\n  ROUND(AVG((likes + shares + comments_count) / views), 4) AS eng_per_view_raw,\n  ROUND(stddev((likes + shares + comments_count) / views), 4) AS eng_std,\n  ROUND(AVG(views), 0) AS avg_views,\n  ROUND(AVG(follower_count), 0) AS avg_followers\nFROM workspace.social.social_media_dataset\nGROUP BY is_sponsored\n"}, {"name": "tile4_audience", "displayName": "Audiencia pior", "query": "\nSELECT\n  audience_age_distribution,\n  audience_gender_distribution,\n  audience_location,\n  platform,\n  content_category,\n  COUNT(*) AS posts,\n  ROUND(AVG((likes + shares + comments_count) / views), 4) AS eng_per_view\nFROM workspace.social.social_media_dataset\nGROUP BY audience_age_distribution, audience_gender_distribution, audience_location,\n         platform, content_category\nHAVING COUNT(*) >= 50\nORDER BY eng_per_view ASC\nLIMIT 20\n"}, {"name": "panel_ranking", "displayName": "Ranking de benchmark", "query": "\nSELECT\n  platform,\n  ROUND(AVG((likes + shares + comments_count) / NULLIF(views, 0)), 4) AS eng_per_view\nFROM workspace.social.social_media_dataset\nGROUP BY platform\nORDER BY eng_per_view DESC\n"}, {"name": "panel_classification", "displayName": "Classificação", "query": "\nSELECT content_type, COUNT(*) AS posts\nFROM workspace.social.social_media_dataset\nGROUP BY content_type\nORDER BY posts DESC\n"}, {"name": "panel_image", "displayName": "Segmentação de imagem", "query": "\nSELECT content_type, COUNT(*) AS posts\nFROM workspace.social.social_media_dataset\nGROUP BY content_type\nORDER BY posts DESC\n"}], "pages": [{"name": "marketing", "displayName": "Marketing", "pageType": "PAGE_TYPE_CANVAS", "layoutVersion": "GRID_V1", "layout": [{"widget": {"name": "title", "multilineTextboxSpec": {"lines": ["## LAB 03 — Entregavel Marketing (004)"]}}, "position": {"x": 0, "y": 0, "width": 12, "height": 1}}, {"widget": {"name": "subtitle", "multilineTextboxSpec": {"lines": ["Taxa derivada (likes+shares+comments_count)/views. Sem engagement_rate nativo. Inclui Bilibili e RedNote."]}}, "position": {"x": 0, "y": 1, "width": 12, "height": 1}}, {"widget": {"name": "w-vol", "queries": [{"name": "main_query", "query": {"datasetName": "tile1_volume", "fields": [{"name": "platform", "expression": "`platform`"}, {"name": "content_type", "expression": "`content_type`"}, {"name": "content_category", "expression": "`content_category`"}, {"name": "posts", "expression": "`posts`"}], "disaggregated": true}}], "spec": {"version": 2, "widgetType": "table", "encodings": {"columns": [{"fieldName": "platform", "displayName": "platform"}, {"fieldName": "content_type", "displayName": "content_type"}, {"fieldName": "content_category", "displayName": "content_category"}, {"fieldName": "posts", "displayName": "posts"}]}, "fr